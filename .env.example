# Backend
BACKEND_NODE_ENV=development
BACKEND_PORT=5000
DATABASE_URL=postgresql://codepath_user:codepath_password@postgres:5432/codepath_db
REDIS_URL=redis://redis:6379
JWT_SECRET=your-super-secret-key-change-this-in-production
