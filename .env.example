# Frontend
REACT_APP_API_URL=http://localhost:5000
REACT_APP_WS_URL=ws://localhost:5000
REACT_APP_ENV=development

# Database (Docker)
POSTGRES_USER=codepath_user
POSTGRES_PASSWORD=codepath_password
POSTGRES_DB=codepath_db
